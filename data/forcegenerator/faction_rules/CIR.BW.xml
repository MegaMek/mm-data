<!-- The Black Warriors, the Circinus Federation's raiding force. Everything not set here comes from the Federation's
     Star League rules (CIR.xml, then IS.xml).

     Doctrine, from Field Manual: Periphery pp.102-103:
       - "To compensate for their light units, the Warriors deploy in reinforced, combined arms companies." Each
         captain "augments his BattleMech company with lances of conventional forces", and the Black Horses "assign
         lances of hovertanks and VTOLs to individual BattleMech companies". So every 'Mek company here carries one
         attached Black Horses lance.
       - Mostly light and medium 'Meks, built for speed; heavy fighters.

     Order of battle, from the same profile (about 3063, until the Warriors left the Federation in late 3067):
       - Colonel Donner's command lance
       - Black Death, a 'Mek battalion
       - Black Hearts, a heavier 'Mek battalion
       - Black Angels, heavy fighters (a reinforced Wing in canon, sized here as an 18-fighter Group)
       - Black Horses, hovertanks and VTOLs, fielded as the lances attached to each 'Mek company rather than as a
         battalion of their own
       - Black Dogs, two companies of jump-capable special forces infantry -->

<ruleset faction="CIR.BW" parent="CIR" ratingSystem="IS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="formationRulesetSchema.xsd">

    <!-- No default unit type: a combined-arms request has to stay blank to reach the Black Warriors rule below. -->
    <defaults>
        <echelon>%BATTALION%</echelon>
        <rankSystem>%RANK_SL%</rankSystem>
        <rating>C</rating>
    </defaults>

    <!-- The Star League baseline menus (IS.xml), plus the whole command as a combined-arms formation. -->
    <toc>
        <unitType>
            <option ifDateBetween="3063,3067">null,Mek,Tank,VTOL,Infantry,BattleArmor,AeroSpaceFighter,Conventional Fighter</option>
            <option ifDateBetween="3051,">Mek,Tank,VTOL,Infantry,BattleArmor,AeroSpaceFighter,Conventional Fighter</option>
            <option>Mek,Tank,VTOL,Infantry,AeroSpaceFighter,Conventional Fighter</option>
        </unitType>

        <echelon>
            <option ifUnitType="">%REGIMENT%</option>
            <option ifUnitType="Mek|Tank|VTOL">%REGIMENT%,%BATTALION%,%COMPANY%,%LANCE%</option>
            <option ifUnitType="Infantry">%REGIMENT%,%BATTALION%,%COMPANY%</option>
            <option ifUnitType="BattleArmor">%BATTALION%,%COMPANY%,%PLATOON%</option>
            <option ifUnitType="AeroSpaceFighter|Conventional Fighter">%AIR_REGIMENT%,%WING%,%SQUADRON%,%FLIGHT%</option>
        </echelon>

        <rating>
            <option>A,B,C,D,F</option>
        </rating>
    </toc>

    <force echelon="%REGIMENT%" eschName="Black Warriors" ifUnitType="" ifDateBetween="3063,3067">
        <name>Black Warriors</name>
        <co>%COLONEL%</co>

        <subforces>
            <subforce unitType="Mek" role="command" name="Command Lance">%LANCE%</subforce>
            <subforce unitType="Mek" weightClass="M" name="Black Death">%BATTALION%</subforce>
            <subforce unitType="Mek" weightClass="H" name="Black Hearts">%BATTALION%</subforce>
            <subforce unitType="AeroSpaceFighter" weightClass="H" name="Black Angels">%WING%</subforce>
            <subforce unitType="Infantry" motive="Jump" num="2" name="Black Dogs">%COMPANY%</subforce>
        </subforces>
    </force>

    <!-- The IS.xml 'Mek battalion, rolled lighter: the Warriors field mostly light and medium 'Meks. -->
    <force echelon="%BATTALION%" eschName="Battalion" ifUnitType="Mek">
        <name>{ordinal} Battalion</name>
        <co>%MAJOR%</co>

        <weightClass>
            <option weight="1">A</option>
            <option weight="4">H</option>
            <option weight="10">M</option>
            <option weight="8">L</option>
        </weightClass>

        <subforces>
            <subforceOption ifWeightClass="A">
                <option weightClass="A,A,H">%COMPANY%</option>
                <option weightClass="A,H,H">%COMPANY%</option>
            </subforceOption>
            <subforceOption ifWeightClass="H">
                <option weightClass="H,H,M">%COMPANY%</option>
                <option weightClass="H,M,M">%COMPANY%</option>
            </subforceOption>
            <subforceOption ifWeightClass="M">
                <option weightClass="H,M,L">%COMPANY%</option>
                <option weightClass="M,M,M">%COMPANY%</option>
                <option weightClass="M,M,L">%COMPANY%</option>
            </subforceOption>
            <subforceOption ifWeightClass="L">
                <option weightClass="M,M,L">%COMPANY%</option>
                <option weightClass="M,L,L">%COMPANY%</option>
                <option weightClass="L,L,L">%COMPANY%</option>
            </subforceOption>
        </subforces>
    </force>

    <!-- A combined-arms company: the IS.xml 'Mek company, rolled lighter, with one Black Horses lance of hovertanks
         or VTOLs as its fourth lance. -->
    <force echelon="%COMPANY%" eschName="Company" ifUnitType="Mek">
        <name ifRole="command">Command Company</name>
        <name>{cardinal:parent}/{alpha} Company</name>
        <co>%CAPTAIN%</co>

        <weightClass>
            <option weight="1">A</option>
            <option weight="4">H</option>
            <option weight="10">M</option>
            <option weight="8">L</option>
        </weightClass>

        <subforces>
            <subforceOption ifWeightClass="A">
                <option weightClass="A,A,H" weight="2">%LANCE%</option>
                <option weightClass="A,H,H" weight="1">%LANCE%</option>
            </subforceOption>
            <subforceOption ifWeightClass="H">
                <option weightClass="H,H,H" weight="2">%LANCE%</option>
                <option weightClass="H,H,M" weight="2">%LANCE%</option>
                <option weightClass="H,M,M" weight="1">%LANCE%</option>
            </subforceOption>
            <subforceOption ifWeightClass="M">
                <option weightClass="H,M,L" weight="1">%LANCE%</option>
                <option weightClass="M,M,M" weight="4">%LANCE%</option>
                <option weightClass="M,M,L" weight="2">%LANCE%</option>
            </subforceOption>
            <subforceOption ifWeightClass="L">
                <option weightClass="M,L,L" weight="2">%LANCE%</option>
                <option weightClass="L,L,L" weight="4">%LANCE%</option>
            </subforceOption>
        </subforces>

        <!-- Part of the company, not an optional detachment: the Warriors deploy this way as a rule, so the lance is
             here whether or not "Generate Detachments" is ticked. Light hovertanks, to keep up with fast 'Meks. -->
        <subforces>
            <subforceOption>
                <option unitType="Tank" motive="Hover" weightClass="L" name="Black Horses Lance" weight="2">%LANCE%</option>
                <option unitType="VTOL" name="Black Horses Lance" weight="1">%LANCE%</option>
            </subforceOption>
        </subforces>
    </force>

</ruleset>
